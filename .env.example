# Safe defaults — do not commit real secrets.
PAPER_TRADING=true
TESTNET_TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
NOBITEX_BASE_URL=https://api.nobitex.ir
NOBITEX_WS_URL=wss://wss.nobitex.ir/connection/websocket
NOBITEX_TESTNET_BASE_URL=https://testnetapi.nobitex.ir
# Optional: fill these locally, never commit them.
NOBITEX_TOKEN=
NOBITEX_TESTNET_TOKEN=
NOBITEX_WEBSOCKET_AUTH_PARAM=
NOBITEX_MARKET=BTCIRT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TRADING_LOOP_INTERVAL=30s
MIN_CONFIDENCE=0.70
MAX_TRADE_QUOTE=1000000
MAX_DAILY_LOSS_QUOTE=2000000

# Human approval gate. The API binds to localhost by default.
APPROVAL_BIND_ADDR=127.0.0.1:8787
APPROVAL_TTL=2m
# Strongly recommended for local approval API access.
APPROVAL_TOKEN=
