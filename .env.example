# Safe defaults — do not commit real secrets.
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false

# Nobitex public API (fixed: the old api.nobitex.ir no longer resolves)
NOBITEX_BASE_URL=https://apiv2.nobitex.ir
NOBITEX_WS_URL=wss://wss.nobitex.ir/connection/websocket

# Legacy plain-token auth (works for public data + older accounts)
NOBITEX_TOKEN=
NOBITEX_API_TOKEN=
NOBITEX_WEBSOCKET_AUTH_PARAM=

# New signed "API Key" auth (recommended for live trading) — see
# https://apidocs.nobitex.ir/api_key/api-key-guide
NOBITEX_API_KEY=
NOBITEX_API_PRIVATE_KEY=

NOBITEX_MARKET=BTCIRT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TRADING_LOOP_INTERVAL=30s
MIN_CONFIDENCE=0.70

# Paper-trading risk gate
MAX_TRADE_QUOTE=1000000
MAX_DAILY_LOSS_QUOTE=2000000

# Live-trading risk gate — separate from paper on purpose
MAX_TRADE_QUOTE_LIVE=1000000
MAX_DAILY_LOSS_LIVE=2000000

# Human approval gate. Leave APPROVAL_BIND_ADDR empty to bind 0.0.0.0:$PORT
# (needed so the Android app can reach it over the network). Set APPROVAL_TOKEN
# whenever this is reachable from outside localhost — it is required, not optional,
# once you deploy this on a public server.
PORT=10000
APPROVAL_BIND_ADDR=
APPROVAL_TTL=2m
APPROVAL_TOKEN=

# Optional Render Binance Spot Testnet relay. Used only when the dashboard Render toggle is ON and mode=sandbox.
RENDER_RELAY_URL=
RENDER_RELAY_TOKEN=
